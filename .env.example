# Ollama (running on HOST, not in Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=2560          # qwen3-embedding:4b output dimension

# Qdrant (Docker service)
QDRANT_URL=http://qdrant:6333      # use service name inside Docker
QDRANT_API_KEY=                    # blank for local
QDRANT_COLLECTION=mynotebooklm_docs

# Neo4j (Docker service)
NEO4J_URI=bolt://neo4j:7687        # use service name inside Docker
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=mynotebooklm123

# Mem0 (Cloud API — get from app.mem0.ai)
MEM0_API_KEY=your_mem0_api_key_here

# App
APP_USER_ID=default_user
LOG_LEVEL=INFO

# Mistral Cloud API
MISTRAL_API_KEY=your_mistral_api_key_here
